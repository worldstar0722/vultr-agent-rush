# Copy to .env (cp .env.example .env). Never commit .env.

# ---- Branding (shown in the UI). TODO: set once the topic is chosen ----
PRODUCT_NAME="TODO: Product Name"
PRODUCT_TAGLINE="TODO: one-line tagline about what the agent does"

# ---- LLM: Vultr Serverless Inference (OpenAI-compatible) ----
# Leave the key EMPTY to run in deterministic MOCK mode (no network, no credentials).
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# TODO: verify - call GET /api/models (with the key set) and paste a real model id here.
# Required when the key is set; the app will not guess a model name.
LLM_MODEL=

# ---- Agent loop ----
# max tool executions per run (retries count)
MAX_STEPS=8
# retries per step after the first attempt
MAX_RETRIES=3
# auto-reject if nobody clicks Approve/Reject
APPROVAL_TIMEOUT_SECONDS=600
# cosmetic pause so the live timeline is watchable
STEP_DELAY_SECONDS=0.4

# ---- Sandbox (Track 1) ----
# false => mock sandbox (nothing is executed). true => real Docker sandbox; needs Docker
# and, inside docker compose, the socket mount described in docker-compose.yml.
# If Docker isn't reachable the app silently falls back to the mock sandbox
# (the header of the UI shows which one is active).
SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY=128m
SANDBOX_CPUS=0.5
SANDBOX_PIDS=64

# ---- Deployment (docker compose only) ----
# Set to a domain whose DNS A record points at the VM => Caddy gets HTTPS automatically.
# Leave empty => plain HTTP on the server IP.
DOMAIN=
