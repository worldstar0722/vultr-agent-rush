# Copy to .env (cp .env.example .env). Never commit .env. No value below is a secret.

# ---- Branding (shown in the UI header) ----
PRODUCT_NAME=GradeCase
PRODUCT_TAGLINE="Case desk for grading exceptions: one case, one evidence bundle"

# ---- Database ----
# SQLite file, seeded from synthetic fixtures on first start. Under docker compose this is
# forced to /data/gradecase.db (a named volume). Holds the lifetime AI counters too.
DB_PATH=/data/gradecase.db
# Intake refuses new cases beyond this many (protects disk on a public demo).
MAX_CASES=200

# ---- AI: Vultr Serverless Inference (OpenAI-compatible). Leave the key EMPTY for mock mode ----
# Mock mode is deterministic and offline: no model is called and the UI says so.
# The key is read from the server environment ONLY. It is never returned by any API, never stored
# in the database, never sent to the browser. Clients cannot choose a model, URL or token cap.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Required when a key is set (otherwise the app reports "misconfigured" and makes no call).
# Discover ids with:  docker compose exec app python -m app.tools models
LLM_MODEL=

# ---- Per-call limits (hard ceilings: larger values here are clamped down) ----
# Seconds before one HTTP attempt is abandoned.
LLM_TIMEOUT_SECONDS=30
# max_completion_tokens sent to the provider. Ceiling 2048.
LLM_MAX_TOKENS=2048
# Reasoning models spend completion tokens on hidden reasoning; with no cap a small limit can leave
# EMPTY content. This is sent as reasoning.max_tokens and kept below LLM_MAX_TOKENS (ceiling 1024).
# 0 omits the field for models that do not support it. Reasoning text is never read or stored.
LLM_REASONING_MAX_TOKENS=128
# Ask for response_format {"type":"json_object"}. Set false only for models that reject it.
LLM_JSON_MODE=true
# UTF-8 bytes allowed in system + user prompt together (with per-message overhead). Ceiling 32768.
# A larger case is refused BEFORE any reservation or network call.
AI_MAX_PROMPT_BYTES=32768
# 0 (default) never retries. 1 allows one retry of a transient failure (timeout, connection error,
# 429, 5xx). The retry reserves its own attempt from the lifetime budget. Ceiling 1.
LLM_MAX_RETRIES=0
LLM_RETRY_DELAY_SECONDS=1

# ---- Spending safety (enforced server-side, persisted in SQLite) ----
# LIFETIME cap on provider HTTP attempts, all visitors together. Every attempt (including a retry)
# is reserved in a transaction BEFORE it is sent and is never refunded, even if it fails.
# Survives container restarts AND "Reset demo data". When used up, live AI stays off (HTTP 429)
# until an operator runs:  python -m app.tools reset-ai-budget --i-understand-this-reauthorises-spend
AI_LIFETIME_MAX_CALLS=50
# Analysis runs per client (salted hash of the address) per rolling hour. 429 + Retry-After.
AI_CLIENT_HOURLY_LIMIT=6

# ---- Deployment (docker compose only) ----
# A domain whose DNS A record points at the VM => Caddy gets HTTPS automatically.
# Leave empty => plain HTTP on the server IP.
DOMAIN=
