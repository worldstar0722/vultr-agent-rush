# Copy to .env (cp .env.example .env). Never commit .env.

# ---- Branding (shown in the UI header) ----
PRODUCT_NAME=GradeCase
PRODUCT_TAGLINE="Case desk for grading exceptions: one case, one evidence bundle"

# ---- Database ----
# SQLite file. Seeded from synthetic fixtures on first start.
# Under docker compose this is forced to /data/gradecase.db (a named volume).
DB_PATH=/data/gradecase.db

# ---- AI (optional) ----
# Leave the key EMPTY for MOCK mode: deterministic, offline, no model is called.
# The app does not claim to use Vultr Serverless Inference unless a key is set.
VULTR_INFERENCE_API_KEY=
# OpenAI-compatible endpoint (verify in the Vultr console / docs before relying on it).
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# TODO: verify - call GET /api/models with the key set and paste a real model id.
# Required when a key is set; the app never guesses a model name.
LLM_MODEL=
# Seconds before an AI call is abandoned and the page falls back to the rules-only view.
LLM_TIMEOUT_SECONDS=20

# ---- Deployment (docker compose only) ----
# A domain whose DNS A record points at the VM => Caddy gets HTTPS automatically.
# Leave empty => plain HTTP on the server IP.
DOMAIN=
